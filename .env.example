# Copy this file to .env and fill in your own values.
# NEVER commit .env — it is listed in .gitignore.

# Anthropic API key (https://console.anthropic.com). Leave blank to run in MOCK mode.
ANTHROPIC_API_KEY=

# Multimodal model used for both ingredient detection and meal generation.
ANTHROPIC_MODEL=claude-haiku-4-5

# Set to 1 to force mock mode (canned AI responses, no API calls, no cost).
MOCK_MODE=0

# Longest edge (pixels) an uploaded photo is resized to before being sent to the model.
MAX_IMAGE_EDGE=1024

# How many times the meal generator may retry when the validator rejects meals.
MAX_GENERATION_ATTEMPTS=2

# Token prices in USD per million tokens, used for the per-session cost estimate.
PRICE_INPUT_PER_MTOK=1.0
PRICE_OUTPUT_PER_MTOK=5.0
